---
import Document from '../../layouts/Document.astro';
import { translator, path, date, type Language, type MessageKey } from '../../lib/i18n';
import { profile, companies, facts } from '../../../content/projects.mjs';
export function getStaticPaths() { return ['ko', 'ja'].map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const t = translator(lang);
const featured = ['performance', 'accessibility', 'sdk'];
---
<Document lang={lang} page="resume">
  <section class="resume-hero">
    <div class="hero-copy"><p class="hero-name">{t('name')}<span>{t('role')}</span></p><h1>{t('resume.title')}</h1><p class="hero-summary">{t('profile.summary')}</p><div class="hero-links"><a class="primary-link" href={path(lang, 'portfolio')}>{t('nav.portfolio')} <span aria-hidden="true">↗</span></a><a class="text-link" href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a></div></div>
    <div class="hero-art" aria-hidden="true"><div class="art-window"><div class="art-toolbar"><span></span><span></span><span></span></div><div class="art-frame"><div class="art-circle"></div><div class="art-line"></div><div class="art-play">▶</div><div class="art-subtitle">Better experience,<br />frame by frame.</div></div><div class="art-timeline"><i></i><span></span><b></b><span></span><i></i></div></div><div class="art-caption">Web frontend<br /><strong>Performance.<br />Accessibility.<br />Connection.</strong></div></div>
  </section>
  <section class="document-section"><div class="section-heading"><h2>{t('section.experience')}</h2><a href={path(lang, 'career')}>{t('nav.career')} ↗</a></div><div class="experience-list">{companies.map(company => <article class="experience"><div class="experience-period">{date(company.start)}<br /><span>— {date(company.end)}</span></div><div><h3>{t(`company.${company.id}` as MessageKey)}</h3><p class="experience-role">{t(`company.${company.id}.role` as MessageKey)}</p><p>{t(`company.${company.id}.summary` as MessageKey)}</p><p class="stack-text">{company.stack}</p></div></article>)}</div></section>
  <section class="document-section"><div class="section-heading"><h2>{t('section.selected')}</h2><span class="section-count">3 projects</span></div><div class="selected-list">{featured.map(id => <a class="selected-item" href={`${path(lang, 'portfolio')}#${id}`}><span class:list={['project-dot', `dot-${id}`]} aria-hidden="true"></span><div><h3>{t(`project.${id}.title` as MessageKey)}</h3><p>{t(`project.${id}.summary` as MessageKey)}</p></div><span aria-hidden="true">↗</span></a>)}</div></section>
  <section class="document-section qualifications"><div><h2>{t('section.skills')}</h2><div class="skill-list">{profile.skills.map(skill => <span>{skill}</span>)}</div></div><div><h2>{t('section.education')}</h2><h3>{t('education.school')}</h3><p>{date(facts.education.koreaMaritimeUniversity.graduationDate)} {t('education.degree')}</p><p>{t('education.certificate')}</p><p>{t('education.language')}</p></div></section>
  <section class="contact-section"><h2>{t('ui.contact')}</h2><p>{t('contact.body')}</p><div><a href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href={profile.blog} target="_blank" rel="noreferrer">{t('ui.blog')} ↗</a></div></section>
</Document>
