---
import '../styles/code-example.css';
import { Code } from 'astro:components';
import { translator, type Language } from '../lib/i18n';
import type { codeExamples } from '../lib/code-examples';
interface Props { lang: Language; example: (typeof codeExamples)[string]; }
const { lang, example } = Astro.props;
const t = translator(lang);
---
<section class="code-example" aria-label={t('code.heading')}>
  <div class="code-intro"><h3>{t('code.heading')}</h3><span>{t('code.illustrative')}</span></div>
  <p class="code-explanation">{t(example.explanation)}</p>
  <div class="code-window" data-code-window>
    <div class="code-toolbar"><span class="code-file"><span class="code-file-type" aria-hidden="true">{example.language === 'tsx' ? 'TSX' : 'TS'}</span>{example.filename}</span><div class="code-actions"><span class="code-readonly">{t('code.readonly')}</span><button type="button" data-code-copy data-label={t('code.copy')} data-copied={t('code.copied')} data-failed={t('code.copyFailed')} aria-label={`${example.filename}: ${t('code.copy')}`}><svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="7" y="7" width="10" height="10" rx="2"/><path d="M12 7V4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h3"/></svg><span data-copy-label>{t('code.copy')}</span></button></div></div>
    <div class="code-scroll" tabindex="0" role="region" aria-label={`${example.filename}: ${t('code.readonly')}`}><Code code={example.code.trimEnd()} lang={example.language} theme="github-light" /></div>
    <p class="code-copy-status" role="status" aria-live="polite" data-copy-status></p>
  </div>
  <p class="code-disclaimer">{t('code.disclaimer')}</p>
  <p class="code-limitation"><strong>{t('code.scope')}</strong> {t(example.limitation)}</p>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-code-window]').forEach(window => {
    const button = window.querySelector<HTMLButtonElement>('[data-code-copy]');
    const label = window.querySelector<HTMLElement>('[data-copy-label]');
    const status = window.querySelector<HTMLElement>('[data-copy-status]');
    button?.addEventListener('click', async () => {
      const code = window.querySelector('pre code')?.textContent;
      if (code === undefined || !label || !status) return;
      button.disabled = true;
      try {
        await navigator.clipboard.writeText(code);
        label.textContent = button.dataset.copied || '';
        status.textContent = button.dataset.copied || '';
      } catch {
        status.textContent = button.dataset.failed || '';
      } finally {
        button.disabled = false;
        setTimeout(() => { label.textContent = button.dataset.label || ''; }, 2000);
      }
    });
  });
</script>
