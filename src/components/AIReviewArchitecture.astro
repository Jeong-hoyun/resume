---
import '../styles/ai-review.css';
import { Image } from 'astro:assets';
import workflowScreenshot from '../assets/n8n-review-workflow.webp';
import { translator, type Language, type MessageKey } from '../lib/i18n';
interface Props { lang: Language; }
const { lang } = Astro.props;
const t = translator(lang);
const steps = ['GitLab MR', t('ai.flow.diff'), 'Claude', t('ai.flow.json'), t('ai.flow.comment')];
---
<section class="review-architecture" aria-labelledby={`review-flow-${lang}`}>
  <h3 id={`review-flow-${lang}`}>{t('ai.architecture')}</h3>
  <div class="review-pipeline">
    <ol class="review-steps">{steps.map((step, index) => <li><span class="review-node-icon" aria-hidden="true">{['↳', '±', '✳', '{}', '↗'][index]}</span><span>{step}</span></li>)}</ol>
    <div class="review-outputs"><span class="review-fallback">{t('ai.flow.fallback')}</span><span>Slack</span><span>Google Sheets</span></div>
  </div>
  <div class="review-decisions">{['input', 'guide', 'delivery'].map(id => <section><h4>{t(`ai.${id}.title` as MessageKey)}</h4><p>{t(`ai.${id}.body` as MessageKey)}</p></section>)}</div>
  <p class="review-infrastructure">{t('ai.infrastructure')}</p>
  <figure class="workflow-evidence">
    <Image src={workflowScreenshot} alt={lang === 'ko' ? '리뷰 응답을 가공한 뒤 GitLab 댓글 게시와 Slack 알림으로 분기하는 n8n 편집 화면' : 'レビュー応答の加工後、GitLabへのコメント投稿とSlack通知に分岐するn8nの編集画面'} />
    <figcaption>
      {lang === 'ko' ? '실제 n8n 워크플로 일부. 리뷰 응답을 가공한 뒤 GitLab 댓글을 등록하고, 처리 상태에 따라 Slack 알림을 보냅니다.' : '実際のn8nワークフローの一部。レビュー応答を加工してGitLabにコメントを投稿し、処理状況に応じてSlackへ通知します。'}
      <a class="text-link" href={workflowScreenshot.src}>{lang === 'ko' ? 'n8n 캡처 크게 보기' : 'n8nの画像を拡大'}</a>
    </figcaption>
  </figure>
</section>

<style>
  .workflow-evidence {
    display: grid;
    justify-items: center;
    margin: 20px 0 0;
  }
  .workflow-evidence img {
    display: block;
    width: min(88%, 680px);
    height: auto;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .workflow-evidence figcaption {
    margin-top: 6px;
    max-width: min(88%, 680px);
    color: var(--muted);
    font-size: 12px;
    text-align: center;
  }
  .workflow-evidence figcaption a {
    display: table;
    margin: 4px auto 0;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 600px) {
    .workflow-evidence img,
    .workflow-evidence figcaption {
      width: 100%;
      max-width: 100%;
    }
  }
</style>
