# Optional production URL, e.g. https://example.com
SITE_URL=
# For GitHub project Pages only, set /resume
BASE_PATH=/
# Spreadsheet with tabs ko and jp (not a publicly published sheet)
# Optional override; the project spreadsheet is in content/sheets.config.mjs
GOOGLE_SHEETS_ID=
# Absolute path to a service account JSON outside the repository
GOOGLE_APPLICATION_CREDENTIALS=
